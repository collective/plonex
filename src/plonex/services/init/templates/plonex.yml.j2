#     install: true  # Install this checkout in .venv, editable by default.
#     extras: [test]
#     test_command: [python, -m, pytest, tests]
#     # distribution: plone-reload  # Use if the package name is computed dynamically.
#     # editable: false  # Build a regular installation instead.
#     # subdirectory: packages/backend  # Python project inside the repository.
#   If no rev is specified, it defaults to main,
